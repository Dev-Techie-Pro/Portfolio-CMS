# ─── Required for deployment (host environment only) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Portfolio site origin(s) allowed to call /api/public/* (comma-separated, no trailing slashes)
# PORTFOLIO_PUBLIC_ORIGINS=https://example.com,https://www.example.com

# Required in production — Bearer token for all /api/cron/* routes (see docs/DEPLOYMENT_CHECKLIST.md)
CRON_SECRET=

# HMAC signing for admin MFA / step-up cookies (falls back to CRON_SECRET if unset)
# SESSION_SIGNING_SECRET=

# Pepper for backup-code hashing (falls back to SESSION_SIGNING_SECRET / CRON_SECRET)
# BACKUP_CODE_PEPPER=

# Signed draft preview tokens for GET /api/public/preview (required in production; do not reuse CRON_SECRET)
# PREVIEW_TOKEN_SECRET=

# Optional — contact form notification recipient (SMTP still configured in admin Settings → System)
# ADMIN_EMAIL=you@example.com

# Optional — shared cache across serverless instances (Upstash / Vercel KV REST)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional — POST Core Web Vitals to /api/metrics/web-vitals (server logs as JSON)
# NEXT_PUBLIC_VITALS_REPORT=1

# Optional — Sentry (enabled when NEXT_PUBLIC_SENTRY_DSN is set; @sentry/nextjs is in package.json)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# SENTRY_AUTH_TOKEN=
